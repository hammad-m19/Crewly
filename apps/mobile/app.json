{
  "expo": {
    "name": "Crewly",
    "slug": "crewly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/3h-logo.jpeg",
    "scheme": "crewly",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/3h-logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "bundleIdentifier": "com.crewly.app",
      "icon": "./assets/images/3h-logo.jpeg"
    },
    "android": {
      "package": "com.crewly.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/3h-logo.jpeg"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/3h-logo.jpeg"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/3h-logo.jpeg",
          "color": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Crewly needs access to your photos to attach receipt images and work progress photos.",
          "cameraPermission": "Crewly needs access to your camera to capture receipt photos and document work progress."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/3h-logo.jpeg",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
