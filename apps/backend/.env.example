# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/crewly

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-too
JWT_REFRESH_EXPIRES_IN=30d

# Firebase (for push notifications) — optional.
# When neither path is set, the API runs normally and FCM pushes are no-ops.
# Download serviceAccountKey.json from Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or use Application Default Credentials:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# Escalation engine (hourly idle/no-show → Owner). Set true in tests.
DISABLE_ESCALATION=false

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
